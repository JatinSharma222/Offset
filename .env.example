

# --- database ---
POSTGRES_USER=Offset
POSTGRES_PASSWORD=Offset
POSTGRES_DB=Offset
DATABASE_URL=postgres://Offset:Offset@postgres:5432/Offset

# --- redis ---
REDIS_URL=redis://redis:6379

# --- server ---
SERVER_PORT=8080
RUST_LOG=info,Offset=debug

# --- hyperliquid ---
HYPERLIQUID_ENV=testnet
HYPERLIQUID_API_URL=https://api.hyperliquid-testnet.xyz
# Agent wallet: authorised to TRADE only. Cannot withdraw — enforced by the exchange.
HYPERLIQUID_AGENT_PRIVATE_KEY=
# The master account being traded on behalf of.
HYPERLIQUID_ACCOUNT_ADDRESS=

# --- solana / data ---
SOLANA_RPC_URL=
PRICE_API_URL=https://api.coingecko.com/api/v3

# --- orchestration ---
LOOP_INTERVAL_SECS=5
MIN_HEDGE_ADJUSTMENT_USD=100
MAX_TOTAL_NOTIONAL_USD=10000000
MAX_SINGLE_ORDER_USD=1000000
MAX_PRICE_STALENESS_SECS=30
KILL_SWITCH=false

# --- frontend ---
VITE_GRAPHQL_HTTP=http://localhost:8080/graphql
VITE_GRAPHQL_WS=ws://localhost:8080/graphql
